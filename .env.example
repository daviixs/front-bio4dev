# ========================================
# Variáveis de Ambiente - Frontend
# ========================================
# 
# IMPORTANTE: Copie este arquivo para .env.local 
# e configure os valores apropriados
#
# O Vite requer o prefixo VITE_ para expor variáveis
# ao código do cliente (browser)
# ========================================

# URL da API Backend
# Use localhost para desenvolvimento local
# Use o IP da máquina (ex: http://192.168.1.100:3000) para acesso via rede local
VITE_API_URL=http://localhost:3000

# ========================================
# ACESSO VIA REDE LOCAL
# ========================================
# Para acessar de outros computadores na mesma rede:
# 1. Descubra o IP da sua máquina: ipconfig getifaddr en0 (macOS)
# 2. Substitua localhost pelo IP local: VITE_API_URL=http://SEU_IP:3000
# Exemplo: VITE_API_URL=http://192.168.1.100:3000

# ========================================
# PRODUÇÃO
# ========================================
# Descomente e configure para produção:
# VITE_API_URL=https://api.bio4dev.com
